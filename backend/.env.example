APP_NAME="Newscast Navigator API"
ENVIRONMENT="development"
DATABASE_URL="postgresql+psycopg://newscast:newscast-dev-only@127.0.0.1:5432/newscast"
# Допустимы оба формата:
# 1) CSV: "http://localhost:5173,http://127.0.0.1:5173,null"
# 2) JSON: ["http://localhost:5173","http://127.0.0.1:5173","null"]
# Значение "null" нужно для прямого fetch из CEP/CaptionPanels.
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,null"
# Разрешает только точный origin `null` для текущего CEP/CaptionPanels fetch.
# Не разрешает wildcard и по умолчанию в коде отключено.
ALLOW_NULL_CORS_ORIGIN=true
SEED_DEMO_DATA=false
SECRET_KEY="change-me-for-production"
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME="newscast_session"
SCENARIO_LEASE_TTL_SECONDS=90

# Только для одноразового `python scripts/bootstrap_admin.py`.
# Не хранить настоящий пароль в .env или git: передавать через окружение процесса.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_DISPLAY_NAME=""
BOOTSTRAP_ADMIN_POSITION=""
BOOTSTRAP_ADMIN_PASSWORD=""
