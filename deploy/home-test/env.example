# Copy to a private .env on the home server, then replace every change-this value.
# Compose binds to 192.168.2.200, the address observed during migration.
# Confirm this is still the reserved home-server LAN IPv4 before installation.
HOME_TEST_HTTPS_PORT=18443
HOME_TEST_SERVER_NAME=192.168.2.200
HOME_TEST_TLS_DIR=/home/newscast/private-demo/home-test/tls
HOME_TEST_DB_IMAGE=change-this-installed-postgres-image-id

POSTGRES_DB=newscast_home_test
POSTGRES_USER=newscast_home_test
POSTGRES_PASSWORD=change-this-home-database-password
DATABASE_URL=postgresql+psycopg://newscast_home_test:change-this-home-database-password@db:5432/newscast_home_test
SECRET_KEY=change-this-home-session-secret-at-least-24-characters
CORS_ORIGINS=https://192.168.2.200:18443,null
CAPTIONPANELS_TOKEN_TTL_SECONDS=28800
SCENARIO_LEASE_TTL_SECONDS=90
